<?xml version="1.0" encoding="utf-8"?>

<robot name="mk_mini" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="$(find mk-mini)/urdf/macros.xacro" />
    
    <link name="base_footprint">
        <!-- <visual>
            <geometry>
                <sphere radius="0.001" />
            </geometry>
        </visual> -->
    </link>

    <link name="base_link">
        <visual>
            <geometry>
                <mesh filename="package://mk-mini/meshes/mk-mini-chassis.STL" scale="1 1 1"/>
            </geometry>
            <origin xyz="0.42 0.26 -0.06" rpy="1.57 0 -1.57" />
            <material name="white">
                <color rgba="1 1 1 1" />
            </material>
        </visual>
        <collision>
            <geometry>
                <box size="0.92 0.74 0.05" />
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
        </collision>
        <inertial>
            <origin xyz="0 0 0" />
            <mass value="10" />
            <inertia 
                ixx="0.066"  
                ixy="0" 
                ixz="0" 
                iyy="0.0735" 
                iyz="0" 
                izz="0.0091" />
        </inertial>
    </link>

    <joint name="base_link2base_footprint" type="fixed">
        <parent link="base_footprint" />
        <child link="base_link"/>
        <origin xyz="0 0 0.032" />
    </joint>




    <link name="left_steering_hinge">
        <visual>
            <geometry>
                <cylinder radius="0.01" length="0.005" />
            </geometry>
            <origin xyz="0 0 0" rpy="1.57 0 0" />
            <material name="black">
                <color rgba="0.0 0.0 0.0 1.0" />
            </material>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.01" length="0.005" />
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="1.57 0.0 0.0" />
        </collision>
        <inertial>
            <origin xyz="0 0 0" />
            <mass value="1" />
            <inertia ixx="2.7E-05" ixy="0" ixz="0" iyy="2.7E-05" iyz="0" izz="5E-05" />
        </inertial>
    </link>


    <joint name="left_steering_hinge_joint" type="revolute">
        <parent link="base_link" />
        <child link="left_steering_hinge" />
        <origin xyz="0.3 0.2335 0" />
        <axis xyz="0 0 1" />
        <limit lower="-0.52333333" upper="0.52333333" effort="2.0" velocity="100.0"/>
    </joint>



    <link name="left_front_wheel">
        <visual>
            <geometry>
                <mesh filename="package://mk-mini/meshes/MK-mini-luntai.STL" scale="1 1 1"/>
            </geometry>
            <origin xyz="-0.1243 0.06 -0.12" rpy="0 0 -1.57" />
            <material name="black">
                <color rgba="0.0 0.0 0.0 1.0" />
            </material>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.12" length="0.05" />
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="1.57 0.0 0.0" />
        </collision>
        <inertial>
            <origin xyz="0 0 0" />
            <mass value="2.0" />
            <inertia ixx="6.64E-04" ixy="0" ixz="0" iyy="6.64E-04" iyz="0" izz="1.02E-03" />
        </inertial>
    </link>

    <joint name="left_front_wheel_joint" type="continuous">
        <parent link="left_steering_hinge" />
        <child link="left_front_wheel" />
        <origin xyz="0 0.025 0" />
        <axis xyz="0 1 0" />
        <limit effort="10" velocity="1000" />
    </joint>


    <link name="right_steering_hinge">
        <visual>
            <geometry>
                 <cylinder radius="0.01" length="0.005" />
            </geometry>
            <origin xyz="0 0 0" rpy="1.57 0 0" />
            <material name="black">
                <color rgba="0.0 0.0 0.0 1.0" />
            </material>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.01" length="0.005" />
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="1.57 0.0 0.0" />
        </collision>
        <inertial>
            <origin xyz="0 0 0" />
            <mass value="1" />
            <inertia ixx="2.7E-05" ixy="0" ixz="0" iyy="2.7E-05" iyz="0" izz="5E-05" />
        </inertial>
    </link>

    <joint name="right_steering_hinge_joint" type="revolute">
        <parent link="base_link" />
        <child link="right_steering_hinge" />
        <origin xyz="0.3 -0.2335 0" />
        <axis xyz="0 0 1" />
        <limit lower="-0.52333333" upper="0.52333333" effort="2.0" velocity="100.0"/>
    </joint>


     <link name="right_front_wheel">
        <visual>
            <geometry>
                <mesh filename="package://mk-mini/meshes/MK-mini-luntai.STL" scale="1 1 1"/>
            </geometry>
            <origin xyz="0.1243 -0.06 -0.12" rpy="0 0 1.57" />
            <material name="black">
                <color rgba="0.0 0.0 0.0 1.0" />
            </material>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.12" length="0.05" />
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="1.57 0.0 0.0" />
        </collision>
        <inertial>
            <origin xyz="0 0 0" />
            <mass value="2.0" />
            <inertia ixx="6.64E-04" ixy="0" ixz="0" iyy="6.64E-04" iyz="0" izz="1.02E-03" />
        </inertial>
    </link>

    <joint name="right_front_wheel_joint" type="continuous">
        <parent link="right_steering_hinge" />
        <child link="right_front_wheel" />
        <origin xyz="0 -0.025 0" />
        <axis xyz="0 1 0" />
        <limit effort="10" velocity="1000" />
    </joint>




    <link name="left_rear_wheel">
        <visual>
            <geometry>
                <mesh filename="package://mk-mini/meshes/MK-mini-luntai.STL" scale="1 1 1"/>
            </geometry>
            <origin xyz="-0.1243 0.06 -0.12" rpy="0 0 -1.57" />
            <material name="black">
                <color rgba="0.0 0.0 0.0 1.0" />
            </material>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.12" length="0.05" />
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="1.57 0.0 0.0" />
        </collision>
        <inertial>
            <origin xyz="0 0 0" />
            <mass value="2.0" />
            <inertia ixx="6.64E-04" ixy="0" ixz="0" iyy="6.64E-04" iyz="0" izz="1.02E-03" />
        </inertial>
    </link>

    <joint name="left_rear_wheel_joint" type="continuous">
        <parent link="base_link" />
        <child link="left_rear_wheel" />
        <origin xyz="-0.3 0.2585 0" />
        <axis xyz="0 1 0" />
        <limit effort="10" velocity="1000" />
    </joint>




    <link name="right_rear_wheel">
        <visual>
            <geometry>
                <mesh filename="package://mk-mini/meshes/MK-mini-luntai.STL" scale="1 1 1"/>
            </geometry>
            <origin xyz="0.1243 -0.06 -0.12" rpy="0 0 1.57" />
            <material name="black">
                <color rgba="0.0 0.0 0.0 1.0" />
            </material>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.12" length="0.05" />
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="1.57 0.0 0.0" />
        </collision>
        <inertial>
            <origin xyz="0 0 0" />
            <mass value="2.0" />
            <inertia ixx="6.64E-04" ixy="0" ixz="0" iyy="6.64E-04" iyz="0" izz="1.02E-03" />
        </inertial>
    </link>

    <joint name="right_rear_wheel_joint" type="continuous">
        <parent link="base_link" />
        <child link="right_rear_wheel" />
        
        <origin xyz="-0.3 -0.2585 0" />
        <axis xyz="0 1 0" />
        <limit effort="10" velocity="1000" />
    </joint>

  <xacro:include filename="$(find mk-mini)/urdf/mk-mini.gazebo" />

</robot>