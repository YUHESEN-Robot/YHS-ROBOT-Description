<?xml version="1.0" encoding="utf-8"?>

<robot name="fw_max" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="$(find fw-max)/urdf/macros.xacro" />
    
    <link name="base_footprint">
        <!-- <visual>
            <geometry>
                <sphere radius="0.001" />
            </geometry>
        </visual> -->
    </link>

    <link name="base_link">
        <visual>
            <geometry>
                <mesh filename="package://fw-max/meshes/fw-max-chassis.STL" scale="1 1 1"/>
            </geometry>
            <origin xyz="0.48 0.275 -0.01" rpy="1.57 0 -1.57" />
            <material name="white">
                <color rgba="1 1 1 1" />
            </material>
        </visual>
        <collision>
            <geometry>
                <box size="0.96 0.55 0.25" />
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
        </collision>
        <inertial>
        <origin xyz="0 0 0" />
        <mass value="75" />
        <inertia 
            ixx="2.8658" ixy="0" ixz="0"
            iyy="6.7327" iyz="0"
            izz="7.6506"
        />
        </inertial>

    </link>

    <joint name="base_link2base_footprint" type="fixed">
        <parent link="base_footprint" />
        <child link="base_link"/>
        <origin xyz="0 0 0.032" />
    </joint>




    <link name="left_steering_hinge">
        <visual>
            <geometry>
                <cylinder radius="0.02" length="0.005" />
            </geometry>
            <origin xyz="0 0 0" rpy="1.57 0 0" />
            <material name="black">
                <color rgba="0.0 0.0 0.0 1.0" />
            </material>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.01" length="0.005" />
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="1.57 0.0 0.0" />
        </collision>
        <inertial>
            <origin xyz="0 0 0" />
            <mass value="1" />
            <inertia ixx="2.7E-05" ixy="0" ixz="0" iyy="2.7E-05" iyz="0" izz="5E-05" />
        </inertial>
    </link>


    <joint name="left_steering_hinge_joint" type="revolute">
        <parent link="base_link" />
        <child link="left_steering_hinge" />
        <origin xyz="0.3 0.225 0" />
        <axis xyz="0 0 1" />
        <limit lower="-1.57" upper="1.57" effort="10.0" velocity="50.0"/>
    </joint>



    <link name="left_front_wheel">
        <visual>
            <geometry>
                <mesh filename="package://fw-max/meshes/fw-max-luntai.STL" scale="1 1 1"/>
            </geometry>
            <origin xyz="0.135 0.055 0.135" rpy="0 3.14 1.57" />
            <material name="black">
                <color rgba="0.0 0.0 0.0 1.0" />
            </material>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.125" length="0.08" />
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="1.57 0.0 0.0" />
        </collision>
        <inertial>
            <origin xyz="0 0 0" />
            <mass value="10" />
            <inertia 
                ixx="0.06040" ixy="0" ixz="0"
                iyy="0.06040" iyz="0"
                izz="0.07812"  
            />
        </inertial>
    </link>

    <joint name="left_front_wheel_joint" type="continuous">
        <parent link="left_steering_hinge" />
        <child link="left_front_wheel" />
        <origin xyz="0 0 0" />
        <axis xyz="0 1 0" />
        <limit effort="10" velocity="1000" />
    </joint>


    <link name="right_steering_hinge">
        <visual>
            <geometry>
                 <cylinder radius="0.02" length="0.005" />
            </geometry>
            <origin xyz="0 0 0" rpy="1.57 0 0" />
            <material name="black">
                <color rgba="0.0 0.0 0.0 1.0" />
            </material>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.01" length="0.005" />
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="1.57 0.0 0.0" />
        </collision>
        <inertial>
            <origin xyz="0 0 0" />
            <mass value="1" />
            <inertia ixx="2.7E-05" ixy="0" ixz="0" iyy="2.7E-05" iyz="0" izz="5E-05" />
        </inertial>
    </link>

    <joint name="right_steering_hinge_joint" type="revolute">
        <parent link="base_link" />
        <child link="right_steering_hinge" />
        <origin xyz="0.3 -0.225 0" />
        <axis xyz="0 0 1" />
        <limit lower="-1.57" upper="1.57" effort="10.0" velocity="50.0"/>
    </joint>


     <link name="right_front_wheel">
        <visual>
            <geometry>
                <mesh filename="package://fw-max/meshes/fw-max-luntai.STL" scale="1 1 1"/>
            </geometry>
            <origin xyz="0.135 -0.055 -0.135" rpy="0 0 1.57" />
            <material name="black">
                <color rgba="0.0 0.0 0.0 1.0" />
            </material>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.125" length="0.08" />
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="1.57 0.0 0.0" />
        </collision>
        <inertial>
            <origin xyz="0 0 0" />
            <mass value="10" />
            <inertia 
                ixx="0.06040" ixy="0" ixz="0"
                iyy="0.06040" iyz="0"
                izz="0.07812"  
            />
        </inertial>
    </link>

    <joint name="right_front_wheel_joint" type="continuous">
        <parent link="right_steering_hinge" />
        <child link="right_front_wheel" />
        <origin xyz="0 0 0" />
        <axis xyz="0 1 0" />
        <limit effort="10" velocity="1000" />
    </joint>



    <link name="rear_left_steering_hinge">
        <visual>
            <geometry>
                <cylinder radius="0.02" length="0.005" />
            </geometry>
            <origin xyz="0 0 0" rpy="1.57 0 0" />
            <material name="black">
                <color rgba="0.0 0.0 0.0 1.0" />
            </material>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.01" length="0.005" />
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="1.57 0.0 0.0" />
        </collision>
        <inertial>
            <origin xyz="0 0 0" />
            <mass value="1" />
            <inertia ixx="2.7E-05" ixy="0" ixz="0" iyy="2.7E-05" iyz="0" izz="5E-05" />
        </inertial>
    </link>


    <joint name="rear_left_steering_hinge_joint" type="revolute">
        <parent link="base_link" />
        <child link="rear_left_steering_hinge" />
        <origin xyz="-0.3 0.225 0" />
        <axis xyz="0 0 1" />
        <limit lower="-1.57" upper="1.57" effort="10.0" velocity="50.0"/>
    </joint>

    <link name="left_rear_wheel">
        <visual>
            <geometry>
                <mesh filename="package://fw-max/meshes/fw-max-luntai.STL" scale="1 1 1"/>
            </geometry>
            <origin xyz="0.135 0.055 0.135" rpy="0 3.14 1.57" />
            <material name="black">
                <color rgba="0.0 0.0 0.0 1.0" />
            </material>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.125" length="0.08" />
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="1.57 0.0 0.0" />
        </collision>
        <inertial>
            <origin xyz="0 0 0" />
            <mass value="10" />
            <inertia 
                ixx="0.06040" ixy="0" ixz="0"
                iyy="0.06040" iyz="0"
                izz="0.07812"  
            />
        </inertial>
    </link>

    <joint name="left_rear_wheel_joint" type="continuous">
        <parent link="rear_left_steering_hinge" />
        <child link="left_rear_wheel" />
        <origin xyz="0 0.0 0" />
        <axis xyz="0 1 0" />
        <limit effort="10" velocity="1000" />
    </joint>




    <link name="rear_right_steering_hinge">
        <visual>
            <geometry>
                <cylinder radius="0.02" length="0.005" />
            </geometry>
            <origin xyz="0 0 0" rpy="1.57 0 0" />
            <material name="black">
                <color rgba="0.0 0.0 0.0 1.0" />
            </material>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.01" length="0.005" />
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="1.57 0.0 0.0" />
        </collision>
        <inertial>
            <origin xyz="0 0 0" />
            <mass value="1" />
            <inertia ixx="2.7E-05" ixy="0" ixz="0" iyy="2.7E-05" iyz="0" izz="5E-05" />
        </inertial>
    </link>


    <joint name="rear_right_steering_hinge_joint" type="revolute">
        <parent link="base_link" />
        <child link="rear_right_steering_hinge" />
        <origin xyz="-0.3 -0.225 0" />
        <axis xyz="0 0 1" />
        <limit lower="-1.57" upper="1.57" effort="10.0" velocity="50.0"/>
    </joint>

    <link name="right_rear_wheel">
        <visual>
            <geometry>
                <mesh filename="package://fw-max/meshes/fw-max-luntai.STL" scale="1 1 1"/>
            </geometry>
            <origin xyz="0.135 -0.055 -0.135" rpy="0 0 1.57" />
            <material name="black">
                <color rgba="0.0 0.0 0.0 1.0" />
            </material>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.125" length="0.08" />
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="1.57 0.0 0.0" />
        </collision>
        <inertial>
            <origin xyz="0 0 0" />
